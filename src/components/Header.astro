---
// Navigatie zonder react-router — statische links + actieve-staat op basis van het pad.
const path = Astro.url.pathname
const nav = [
  { href: '/', label: 'Home', exact: true },
  { href: '/ben-ik-financieel-onafhankelijk', label: 'Ben ik FO?' },
  { href: '/bruto-netto', label: 'Bruto-netto' },
  { href: '/tools/jaarruimte', label: 'Jaarruimte' },
]
const isActive = (href: string, exact?: boolean) =>
  exact ? path === href : path === href || path.startsWith(href + '/')
---

<header
  class="bg-white border-b border-slate-100 px-4 md:px-6 py-3 flex items-center gap-4 flex-shrink-0"
>
  <!-- Logo -->
  <a href="/" class="flex items-center gap-2.5 flex-shrink-0" aria-label="Naar de homepagina">
    <span class="w-8 h-8 rounded-lg bg-primary-600 flex items-center justify-center">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="white"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
        <polyline points="16 7 22 7 22 13"></polyline>
      </svg>
    </span>
    <span class="hidden sm:block text-sm font-bold text-slate-900 leading-none">
      Ben ik financieel onafhankelijk?
    </span>
  </a>

  <!-- Navigatie -->
  <nav class="flex items-center gap-1 overflow-x-auto">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'px-3 py-1.5 rounded-lg text-sm font-medium transition whitespace-nowrap',
            isActive(item.href, item.exact)
              ? 'bg-primary-50 text-primary-600'
              : 'text-slate-500 hover:text-slate-800 hover:bg-slate-100',
          ]}
          aria-current={isActive(item.href, item.exact) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
