---
import { InstallAppButton } from './InstallAppButton'

// Navigatie zonder react-router — statische links + actieve-staat op basis van het pad.
const path = Astro.url.pathname
const nav = [
  { href: '/', label: 'Home', exact: true },
  { href: '/uitleg', label: 'Uitleg' },
  { href: '/tools', label: 'Rekentools' },
  { href: '/over', label: 'Over' },
]
const isActive = (href: string, exact?: boolean) =>
  exact ? path === href : path === href || path.startsWith(href + '/')
---

<header
  class="bg-canvas border-b border-[#D2CDC5] px-4 md:px-6 py-3 flex items-center gap-4 flex-shrink-0"
>
  <!-- Logo -->
  <a href="/" class="flex items-center gap-2.5 flex-shrink-0" aria-label="Naar de homepagina">
    <span class="w-6 h-6 rounded-[3px] bg-ink flex items-center justify-center">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#EBE9E6"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
        <polyline points="16 7 22 7 22 13"></polyline>
      </svg>
    </span>
    <span class="hidden sm:block text-[15px] font-medium text-ink leading-none">
      Ben ik financieel onafhankelijk?
    </span>
  </a>

  <!-- Navigatie -->
  <nav class="flex items-center gap-1 overflow-x-auto">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'px-[13px] py-1.5 rounded-[3px] text-sm transition whitespace-nowrap',
            isActive(item.href, item.exact)
              ? 'bg-morning text-ink'
              : 'text-body hover:text-ink hover:bg-warmwhite',
          ]}
          aria-current={isActive(item.href, item.exact) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <InstallAppButton
    client:load
    className="ml-auto flex items-center gap-1.5 px-3 py-1.5 text-sm text-ink border border-sand hover:bg-warmwhite rounded-[3px] transition-colors flex-shrink-0"
  />
</header>
