---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import { faqSchema } from '../lib/seo'
import hoofdtoolPreview from '../assets/hoofdtool-preview.webp'

const title = 'Ben ik financieel onafhankelijk? — Uitleg & gratis rekentools'
const description =
  'Onafhankelijke uitleg en gratis rekentools over financiële onafhankelijkheid, pensioen en vermogensopbouw. Kort, begrijpelijk en voor iedereen te gebruiken.'

const hoofdtool = {
  href: '/ben-ik-financieel-onafhankelijk',
  naam: 'Rekentool financieel onafhankelijk?',
  tekst: 'Reken eenvoudig uit wat er voor jou nodig is om financieel onafhankelijk te zijn.',
  onderschrift:
    'Vul je pensioen, je vermogen, het gewenste inkomen en spaargedrag in en check met welke aannames je wilt rekenen. Je krijgt als resultaat een uitgebreide kansverdeling voor het wel of niet kunnen halen van je financiële doelen.',
}

const tools = [
  {
    href: '/bruto-netto',
    naam: 'Bruto-netto berekenen',
    tekst:
      'Zie wat je van je bruto salaris netto overhoudt (of andersom), inclusief belastingschijven en heffingskortingen voor 2026.',
    label: 'Salaris',
  },
  {
    href: '/tools/jaarruimte',
    naam: 'Jaarruimte berekenen',
    tekst:
      'Bereken hoeveel je fiscaal aftrekbaar mag inleggen voor extra pensioen om een pensioentekort aan te vullen.',
    label: 'Pensioen',
  },
  {
    href: '/tools/inflatie',
    naam: 'Inflatie & spaargeld',
    tekst:
      'Zie hoe snel inflatie de koopkracht van je spaargeld uitholt, ook als het rente oplevert.',
    label: 'Inflatie',
  },
]

const faq = [
  {
    vraag: 'Wat betekent financieel onafhankelijk zijn?',
    antwoord:
      'Je bent financieel onafhankelijk als je genoeg vermogen of inkomen hebt om je vaste lasten te betalen zonder dat je hoeft te werken. Je leeft dan van rendement, spaargeld, pensioen of een combinatie daarvan.',
  },
  {
    vraag: 'Zijn de tools op deze site gratis?',
    antwoord:
      'Ja. Alle rekentools en uitleg zijn gratis te gebruiken. Je hoeft niets te installeren en geen account aan te maken.',
  },
]

const schemas = [faqSchema(faq)]
---

<BaseLayout title={title} description={description} canonical="/" jsonLd={schemas}>
  <main class="flex-1">
    <!-- Hero -->
    <section class="max-w-3xl mx-auto px-4 md:px-6 pt-12 pb-8 text-center">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 leading-tight">
        Ben ik financieel onafhankelijk?
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Begrijpelijke uitleg en gratis rekentools over vermogensopbouw, pensioen en financiële
        onafhankelijkheid. Geen verkooppraat, geen kleine lettertjes — gewoon zelf uitrekenen
        hoe je ervoor staat.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 justify-center">
        <a
          href={hoofdtool.href}
          class="px-5 py-2.5 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition"
        >
          Start de tool
        </a>
        <a
          href="/uitleg"
          class="px-5 py-2.5 rounded-lg bg-white text-slate-700 text-sm font-medium border border-slate-200 hover:bg-slate-50 transition"
        >
          Lees de uitleg
        </a>
      </div>
    </section>

    <!-- Tools -->
    <section id="tools" class="max-w-5xl mx-auto px-4 md:px-6 py-8">
      <div class="flex items-baseline justify-between mb-5">
        <h2 class="text-xl font-semibold text-slate-900">Rekentools</h2>
        <a href="/tools" class="text-sm font-medium text-primary-600 hover:underline">Alle rekentools →</a>
      </div>

      <a
        href={hoofdtool.href}
        class="block rounded-2xl bg-primary-600 hover:bg-primary-700 transition text-white p-6 md:p-8 group"
      >
        <div class="md:flex md:items-center md:gap-8">
          <div class="md:flex-1 min-w-0">
            <span class="text-xs font-semibold uppercase tracking-wide text-primary-100">
              Hoofdtool
            </span>
            <span class="mt-2 block text-2xl md:text-3xl font-bold">
              {hoofdtool.naam}
            </span>
            <span class="mt-2 block text-primary-50 leading-relaxed max-w-2xl">
              {hoofdtool.tekst}
            </span>
            <span class="mt-2 block text-primary-100 text-xs leading-relaxed max-w-2xl">
              {hoofdtool.onderschrift}
            </span>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium bg-white text-primary-700 rounded-lg px-3 py-1.5 group-hover:bg-primary-50 transition">
              Start de tool →
            </span>
          </div>
          <div class="mt-6 md:mt-0 md:w-72 lg:w-80 flex-shrink-0">
            <Image
              src={hoofdtoolPreview}
              alt="Voorbeeld van de rekentool: vermogensontwikkeling en de kans op je inkomensdoel"
              class="w-full h-auto rounded-lg shadow-lg ring-1 ring-white/20"
              widths={[400, 800]}
              sizes="(min-width: 768px) 320px, 90vw"
              loading="eager"
            />
          </div>
        </div>
      </a>

      <p class="mt-8 mb-4 text-sm font-semibold text-slate-500 uppercase tracking-wide">
        Meer rekentools
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          tools.map((t) => (
            <a
              href={t.href}
              class="card hover:shadow-md hover:border-primary-100 transition group flex flex-col"
            >
              <span class="text-xs font-medium text-primary-600 uppercase tracking-wide">
                {t.label}
              </span>
              <span class="mt-1 text-lg font-semibold text-slate-900 group-hover:text-primary-600 transition">
                {t.naam}
              </span>
              <span class="mt-2 text-sm text-slate-500 leading-relaxed">{t.tekst}</span>
              <span class="mt-4 text-sm font-medium text-primary-600">Naar de tool →</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Wat is FO -->
    <section class="max-w-3xl mx-auto px-4 md:px-6 py-8">
      <h2 class="text-xl font-semibold text-slate-900 mb-3">
        Wat betekent financieel onafhankelijk?
      </h2>
      <div class="prose-sm text-slate-600 leading-relaxed space-y-3">
        <p>
          Je bent <strong>financieel onafhankelijk</strong> als je je vaste lasten kunt betalen
          zonder dat je hoeft te werken. Je inkomen komt dan uit vermogen, rendement, pensioen of
          een combinatie daarvan. Voor de een is dat vervroegd stoppen met werken, voor de ander
          simpelweg rust: weten dat het geregeld is.
        </p>
        <p>
          Hoeveel je daarvoor nodig hebt, hangt af van je uitgaven, je leeftijd, je pensioen en het
          rendement dat je verwacht. Precies die knoppen kun je op deze site zelf verdraaien in de
          rekentools — zodat je niet hoeft te gokken, maar kunt rekenen.
        </p>
        <p>
          <a
            href="/uitleg/wat-is-financiele-onafhankelijkheid"
            class="text-primary-600 font-medium hover:underline"
          >Lees de uitleg: wat is financiële onafhankelijkheid? →</a>
        </p>
      </div>
    </section>

    <!-- Voor wie -->
    <section class="max-w-5xl mx-auto px-4 md:px-6 py-8">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="card">
          <h3 class="text-base font-semibold text-slate-900 mb-1">Voor iedereen</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Of je nu net begint met sparen of al een vermogen hebt opgebouwd: de uitleg is in
            gewone taal en de tools zijn gratis en zonder account te gebruiken.
          </p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold text-slate-900 mb-1">Voor adviseurs</h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            Pensioen- en financieel adviseurs gebruiken de planner ook in klantgesprekken, met een
            klantnaam per sessie en export naar Excel en PDF.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
