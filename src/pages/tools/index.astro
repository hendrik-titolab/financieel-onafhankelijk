---
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { breadcrumbSchema, itemListSchema } from '../../lib/seo'
import hoofdtoolPreview from '../../assets/hoofdtool-preview.webp'

const title = 'Rekentools | Gratis financiële calculators'
const description =
  'Alle gratis rekentools op een rij: financiële onafhankelijkheid, bruto-netto salaris, jaarruimte voor pensioen en het effect van inflatie op je spaargeld.'

const hoofdtool = {
  href: '/ben-ik-financieel-onafhankelijk/',
  naam: 'Rekentool financieel onafhankelijk?',
  tekst: 'Reken eenvoudig uit wat er voor jou nodig is om financieel onafhankelijk te zijn.',
  onderschrift:
    'Vul je pensioen, je vermogen, het gewenste inkomen en spaargedrag in en check met welke aannames je wilt rekenen. Je krijgt als resultaat een uitgebreide kansverdeling voor het wel of niet kunnen halen van je financiële doelen.',
}

const tools = [
  {
    href: '/bruto-netto/',
    naam: 'Bruto-netto berekenen',
    label: 'Salaris',
    tekst:
      'Zie wat je van je brutosalaris netto overhoudt (of andersom), inclusief belastingschijven en heffingskortingen voor 2026.',
  },
  {
    href: '/tools/jaarruimte/',
    naam: 'Jaarruimte berekenen',
    label: 'Pensioen',
    tekst:
      'Bereken hoeveel je fiscaal aftrekbaar mag inleggen voor extra pensioen om een pensioentekort aan te vullen.',
  },
  {
    href: '/tools/inflatie/',
    naam: 'Inflatie & spaargeld',
    label: 'Inflatie',
    tekst:
      'Zie hoe snel inflatie de koopkracht van je spaargeld uitholt, ook als het rente oplevert.',
  },
]

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Rekentools', path: '/tools/' },
]
const schemas = [
  breadcrumbSchema(crumbs),
  itemListSchema([hoofdtool, ...tools].map((t) => ({ name: t.naam, path: t.href }))),
]
---

<BaseLayout title={title} description={description} canonical="/tools/" jsonLd={schemas}>
  <main class="flex-1">
    <div class="max-w-5xl mx-auto px-4 md:px-6 py-10">
      <nav class="text-xs text-slate-400 mb-4 flex flex-wrap items-center gap-1.5" aria-label="Kruimelpad">
        <a href="/" class="hover:text-primary-600">Home</a><span>/</span>
        <span class="text-slate-500">Rekentools</span>
      </nav>

      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">Rekentools</h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed max-w-2xl">
        Gratis en zonder account. Reken zelf uit hoe je ervoor staat, in plaats van te gokken.
      </p>

      <a
        href={hoofdtool.href}
        class="mt-8 block rounded-2xl bg-primary-600 hover:bg-primary-700 transition text-white p-6 md:p-8 group"
      >
        <div class="md:flex md:items-center md:gap-8">
          <div class="md:flex-1 min-w-0">
            <span class="text-xs font-semibold uppercase tracking-wide text-primary-100">
              Hoofdtool
            </span>
            <span class="mt-2 block text-2xl md:text-3xl font-bold">
              {hoofdtool.naam}
            </span>
            <span class="mt-2 block text-primary-50 leading-relaxed max-w-2xl">
              {hoofdtool.tekst}
            </span>
            <span class="mt-2 block text-primary-100 text-xs leading-relaxed max-w-2xl">
              {hoofdtool.onderschrift}
            </span>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium bg-white text-primary-700 rounded-lg px-3 py-1.5 group-hover:bg-primary-50 transition">
              Start de tool →
            </span>
          </div>
          <div class="mt-6 md:mt-0 md:w-72 lg:w-80 flex-shrink-0">
            <Image
              src={hoofdtoolPreview}
              alt="Voorbeeld van de rekentool: vermogensontwikkeling en de kans op je inkomensdoel"
              class="w-full h-auto rounded-lg shadow-lg ring-1 ring-white/20"
              widths={[400, 800]}
              sizes="(min-width: 768px) 320px, 90vw"
              loading="eager"
            />
          </div>
        </div>
      </a>

      <p class="mt-10 text-sm font-semibold text-slate-500 uppercase tracking-wide">
        Meer rekentools
      </p>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        {
          tools.map((t) => (
            <a
              href={t.href}
              class="card hover:shadow-md hover:border-primary-100 transition group flex flex-col"
            >
              <span class="text-xs font-medium text-primary-600 uppercase tracking-wide">
                {t.label}
              </span>
              <span class="mt-1 text-lg font-semibold text-slate-900 group-hover:text-primary-600 transition">
                {t.naam}
              </span>
              <span class="mt-2 text-sm text-slate-500 leading-relaxed">{t.tekst}</span>
              <span class="mt-4 text-sm font-medium text-primary-600">Naar de tool →</span>
            </a>
          ))
        }
      </div>

      <p class="mt-8 text-sm text-slate-500">
        Op zoek naar uitleg in plaats van een rekentool?{' '}
        <a href="/uitleg" class="text-primary-600 font-medium hover:underline">Lees de uitleg →</a>
      </p>
    </div>
  </main>
</BaseLayout>
