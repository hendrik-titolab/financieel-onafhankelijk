---
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { breadcrumbSchema, itemListSchema } from '../../lib/seo'
import hoofdtoolPreview from '../../assets/hoofdtool-preview.webp'
import { HOOFDTOOL as hoofdtool, TOOLS as tools } from '../../config/rekentools'

const title = 'Rekentools | Gratis financiële calculators'
const description =
  'Alle gratis rekentools op een rij: financiële onafhankelijkheid, bruto-netto, jaarruimte, inflatie, box 3 en wat rente op rente met je vermogen doet.'

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Rekentools', path: '/tools/' },
]
const schemas = [
  breadcrumbSchema(crumbs),
  itemListSchema([hoofdtool, ...tools].map((t) => ({ name: t.naam, path: t.href }))),
]
---

<BaseLayout title={title} description={description} canonical="/tools/" jsonLd={schemas}>
  <main class="flex-1">
    <div class="max-w-5xl mx-auto px-4 md:px-6 py-10">
      <nav class="text-xs text-body mb-4 flex flex-wrap items-center gap-1.5" aria-label="Kruimelpad">
        <a href="/" class="hover:text-ink">Home</a><span>/</span>
        <span class="text-ink">Rekentools</span>
      </nav>

      <h1 class="font-serif text-3xl md:text-4xl text-ink">Rekentools</h1>
      <p class="mt-3 text-lg text-body leading-relaxed max-w-2xl">
        Gratis en zonder account. Reken zelf uit hoe je ervoor staat, in plaats van te gokken.
      </p>

      <a
        href={hoofdtool.href}
        class="mt-8 block rounded-[3px] bg-ink hover:bg-[#1F2C23] transition text-warmwhite p-6 md:p-8 group"
      >
        <div class="md:flex md:items-center md:gap-8">
          <div class="md:flex-1 min-w-0">
            <span class="font-mono text-[11px] uppercase tracking-[0.06em] text-on-dark">
              Hoofdtool
            </span>
            <span class="mt-2 block text-2xl md:text-3xl">
              {hoofdtool.naam}
            </span>
            <span class="mt-2 block text-warmwhite leading-relaxed max-w-2xl">
              {hoofdtool.tekst}
            </span>
            <span class="mt-2 block text-on-dark text-xs leading-relaxed max-w-2xl">
              {hoofdtool.onderschrift}
            </span>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm bg-warmwhite text-ink rounded-[3px] px-3 py-1.5 group-hover:bg-white transition">
              Start de tool →
            </span>
          </div>
          <div class="mt-6 md:mt-0 md:w-72 lg:w-80 flex-shrink-0">
            <Image
              src={hoofdtoolPreview}
              alt="Voorbeeld van de rekentool: vermogensontwikkeling en de kans op je inkomensdoel"
              class="w-full h-auto rounded-[3px] ring-1 ring-warmwhite/20"
              widths={[400, 800]}
              sizes="(min-width: 768px) 320px, 90vw"
              loading="eager"
            />
          </div>
        </div>
      </a>

      <p class="label-mono mt-10">Meer rekentools</p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {
          tools.map((t) => (
            <a
              href={t.href}
              class="card hover:border-ink transition group flex flex-col"
            >
              <span class="label-mono">{t.label}</span>
              <span class="mt-1 text-lg text-ink transition">{t.naam}</span>
              <span class="mt-2 text-sm text-body leading-relaxed">{t.tekst}</span>
              <span class="mt-4 text-sm text-data-700">Naar de tool →</span>
            </a>
          ))
        }
      </div>

      <p class="mt-8 text-sm text-body">
        Op zoek naar uitleg in plaats van een rekentool?{' '}
        <a href="/uitleg" class="text-data-700 hover:underline">Lees de uitleg →</a>
      </p>
    </div>
  </main>
</BaseLayout>
